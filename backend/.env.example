# 9 CLOVER — Competitive Operations backend configuration.
# Copy to .env (ignored by Git) or export the values in your shell.
# Every variable is optional in development — defaults live in app/config.py.

# --- server ---------------------------------------------------------------
CLOVER_HOST=0.0.0.0
CLOVER_PORT=9000

# --- database -------------------------------------------------------------
# Default: sqlite:///<backend>/data/clover.db (created and seeded on first boot)
# Use a persistent volume; non-SQLite URLs also need the appropriate DB driver.
CLOVER_DATABASE_URL=

# --- security -------------------------------------------------------------
# CHANGE THIS before exposing the API: it signs every session token.
CLOVER_SECRET_KEY=
CLOVER_TOKEN_TTL_HOURS=168

# Bootstrap admin account (created once, on first boot).
CLOVER_ADMIN_EMAIL=admin@9clover.gg
CLOVER_ADMIN_PASSWORD=clover2026

# --- cors -----------------------------------------------------------------
# Comma separated extra origins. The default regex already allows localhost
# and *.e2b.app preview tunnels.
CLOVER_CORS_ORIGINS=
CLOVER_CORS_REGEX=https?://(localhost|127\.0\.0\.1|.*\.e2b\.app)(:\d+)?

# --- optional example data -------------------------------------------------
# Only 1/true/yes/on seeds example roster accounts and fictional operational data.
# The bootstrap admin, hero defaults and settings are created on an empty DB.
CLOVER_DEMO_DATA=0

# --- Aerena esports -------------------------------------------------------
# Automatic read-only refresh is on by default; disable with 0 if source use
# is not approved, or when this server cannot make outbound HTTPS requests.
# Aerena's website implementation may change; observe the feed status in-app.
CLOVER_AERENA_ENABLED=1
# Default 2 hours, minimum 5 minutes. Failures retry after at most 15 minutes.
CLOVER_AERENA_SYNC_SECONDS=7200

# --- optional server-side AI provider --------------------------------------
# Admins can save or rotate the API key in Team Admin over HTTPS. It is stored
# encrypted in the database and is never returned to the browser. Alternatively,
# set this on the backend host; a Team Admin key takes precedence. Blank with no
# saved key = local facts-only summaries. Never put keys in source control/chat.
CLOVER_AI_API_KEY=
# Optional Fernet encryption key for saved credentials (not AI chats or coaching notes).
# If blank, the app creates an owner-only key file in backend/data on POSIX; on Windows restrict the folder
# ACL to the service account. Preserve the key separately from database backups.
# For multi-host deployments, supply the same secret on each worker via your
# secret manager. Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOVER_CREDENTIAL_ENCRYPTION_KEY=
# The app does not impose a daily AI or search cap. Provider limits and billing
# still apply, including failed attempts where charged by the provider.
# Live search uses the same server credential, may be billed separately, and
# sends only the current question as a query. 0 disables it for all members.
CLOVER_AI_WEB_SEARCH=1
# Optional operator override; leave blank to use the supported default model.
CLOVER_AI_MODEL=
# Separate optional override for the stronger Think-mode model in Clover AI chat.
CLOVER_AI_THINK_MODEL=
