# Absolute Genesis backend configuration.
# Copy to .env and export the values, or set them in your shell/process manager.
# Every variable is optional in development — sensible defaults live in app/config.py.

# --- server ---------------------------------------------------------------
CBT_HOST=0.0.0.0
CBT_PORT=3000

# --- database -------------------------------------------------------------
# Default: sqlite:///<backend>/data/arena.db  (created and seeded on first boot)
# Any SQLAlchemy URL works, e.g.
# CBT_DATABASE_URL=postgresql+psycopg://arena:arena@localhost:5432/arena
CBT_DATABASE_URL=

# --- security -------------------------------------------------------------
# CHANGE THIS before exposing the API: it signs every session token.
CBT_SECRET_KEY=
CBT_TOKEN_TTL_HOURS=168

# Bootstrap staff account (created once, on first boot).
CBT_ADMIN_EMAIL=admin@quizarena.ng
CBT_ADMIN_PASSWORD=arena2026

# --- cors -----------------------------------------------------------------
# Comma separated extra origins. The default regex already allows localhost
# and *.e2b.app preview tunnels.
CBT_CORS_ORIGINS=
CBT_CORS_REGEX=https?://(localhost|127\.0\.0\.1|.*\.e2b\.app)(:\d+)?

# --- AI writing help (optional) -------------------------------------------
# Tip: the owner can also paste/replace these keys in Admin → AI Tutor → Models
# → API keys; they take effect immediately (no restart) and override this file.
# "Make it easy to read" in the material editor rewrites content with Google
# Gemini's free tier. Get a free key at https://aistudio.google.com → Get API key.
# Staff always review the rewrite before it is used. Leave empty to disable.
GEMINI_API_KEY=
# Optional: pin a model (default follows Google's current free Flash model).
# GEMINI_MODEL=gemini-flash-latest

# Or DeepSeek (paid but very cheap, usually faster): create a key at
# https://platform.deepseek.com → API keys, add a small balance. When this is
# set DeepSeek is used; AI_PROVIDER=gemini|deepseek forces one.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# AI_PROVIDER=auto

# AI Tutor — uses DeepSeek or Gemini (whichever key is set; staff can pick the
# provider/model in Staff → AI Tutor → Models). Keys never reach the browser.
# These are first-run defaults; staff change limits/features in the app.
# AI_ENABLED=true              # false = hard off switch for the whole server
# AI_PROVIDER=auto             # deepseek | gemini | auto
# AI_MODEL=                    # e.g. deepseek-flash or gemini-flash-latest
# AI_DAILY_LIMIT=20            # requests per student per day
# AI_MONTHLY_LIMIT=400
# AI_MAX_MESSAGE_LENGTH=4000   # characters
# AI_MAX_RESPONSE_TOKENS=1800
# AI_MONTHLY_BUDGET_USD=0      # stop all AI requests past this estimated monthly cost (0 = no cap)
# AI_MAX_UPLOAD_MB=10
# AI_RETRY_BASE=1              # seconds; retries wait 1s, 2s, 4s on 429/5xx/network errors
# AI_PRICE_INPUT= / AI_PRICE_CACHED= / AI_PRICE_OUTPUT=   # USD per 1M tokens (overrides AI_PRICING_CONFIG)
# TUTOR_STREAM_TIMEOUT=45
