{
  "name": "absolute-genesis-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Absolute Genesis \u2014 real-time CBT, duels, leaderboards and prizes (React + Vite + Tailwind v4)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "predev": "node scripts/make-brand.mjs",
    "build": "vite build",
    "prebuild": "node scripts/make-brand.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "audit:visual": "node scripts/visual-audit.mjs",
    "clean": "rm -rf dist",
    "check:music": "node scripts/music-check.mjs",
    "check:fonts": "node scripts/font-check.mjs",
    "audit:archive": "node scripts/archive-audit.mjs",
    "audit:chat-profile": "node scripts/chat-profile-audit.mjs",
    "audit:profile-art": "node scripts/profile-art-audit.mjs",
    "audit:country-world": "node scripts/country-world-audit.mjs",
    "brand": "node scripts/make-brand.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.12",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
