{
  "name": "clover-hub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "9 CLOVER — competitive training & analysis hub (React + Vite + Tailwind v4)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9009",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 9009",
    "typecheck": "tsc --noEmit",
    "test:map-chips": "node --test tests/map-chips.test.mjs",
    "test:map": "node --test tests/map-chips.test.mjs tests/map-zones.test.mjs tests/map-elements.test.mjs",
    "clean": "rm -rf dist",
    "test:esports": "node --test tests/esports.test.mjs tests/rone-esports.test.mjs",
    "test:ai": "node --test tests/clover-ai.test.mjs tests/ai-workspace-layout.test.mjs tests/ai-learning.test.mjs tests/ai-thinking.test.mjs tests/ai-esports.test.mjs tests/ai-visuals.test.mjs",
    "test:focus": "node --test tests/team-focus.test.mjs",
    "test:ui": "node --test tests/section-pill.test.mjs tests/font.test.mjs tests/font-prefs.test.mjs tests/theme.test.mjs tests/layout-revamp.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/noto-sans-symbols": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
