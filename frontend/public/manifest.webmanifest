{
  "id": "/",
  "name": "9 Clover — The Hub",
  "short_name": "9 Clover",
  "description": "Private competitive training, analysis and strategy hub for 9 Clover. Play. Review. Adapt. Dominate.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=app#/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070a12",
  "theme_color": "#070a12",
  "categories": ["games", "sports", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/icon-monochrome.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Dashboard", "url": "/?source=shortcut#/dashboard", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "9 Clover AI", "short_name": "AI", "url": "/?source=shortcut#/ai", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Draft Lab", "short_name": "Drafts", "url": "/?source=shortcut#/drafts", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Scrims", "url": "/?source=shortcut#/scrims", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/brand/screenshot-wide.webp", "sizes": "1440x900", "type": "image/webp", "form_factor": "wide", "label": "Team dashboard" },
    { "src": "/brand/screenshot-narrow.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "Dashboard on a phone" }
  ]
